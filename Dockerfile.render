# Imagen única para Render: Django sirve la API, el admin Y el frontend compilado.
# (En el servidor propio con docker-compose se usa nginx; aquí no hace falta.)

# Etapa 1: compila el frontend (React + Vite).
FROM node:22-alpine AS frontend
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html vite.config.js ./
COPY src ./src
RUN npm run build

# Etapa 2: Django + gunicorn, con el frontend dentro.
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install -r requirements.txt

COPY backend/ .
COPY --from=frontend /app/dist ./frontend_dist

RUN python manage.py collectstatic --noinput

RUN useradd --system --no-create-home --uid 10001 famoc \
    && chmod +x /app/entrypoint.sh \
    && chown -R famoc:famoc /app
USER famoc

EXPOSE 10000

ENTRYPOINT ["/app/entrypoint.sh"]
# Render indica el puerto en la variable PORT.
CMD ["sh", "-c", "gunicorn erpfamoc.wsgi:application --bind 0.0.0.0:${PORT:-10000} --workers 2 --access-logfile -"]
